Cell[CellGroupData[{

Cell[BoxData[
 FormBox[
  InterpretationBox[
   RowBox[{"\<\"\\n f\[CapitalTheta] = \"\>", "\[InvisibleSpace]", 
    FractionBox[
     RowBox[{
      SqrtBox[
       RowBox[{
        FractionBox[
         RowBox[{"4", " ", 
          SuperscriptBox["m", "2"]}], 
         RowBox[{
          SuperscriptBox["q", "2"], "-", 
          SuperscriptBox["q0", "2"]}]], "+", "1"}]], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"8", " ", 
            SuperscriptBox["q", "4"]}], "-", 
           RowBox[{"20", " ", 
            SuperscriptBox["q0", "2"], " ", 
            SuperscriptBox["q", "2"]}], "+", 
           RowBox[{"15", " ", 
            SuperscriptBox["q0", "4"]}]}], ")"}], " ", 
         SuperscriptBox["m", "4"]}], "+", 
        RowBox[{"4", " ", 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["q", "2"], "-", 
           SuperscriptBox["q0", "2"]}], ")"}], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"40", " ", "\[Xi]"}], "-", "6"}], ")"}], " ", 
            SuperscriptBox["q", "4"]}], "-", 
           RowBox[{"20", " ", 
            SuperscriptBox["q0", "2"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"6", " ", "\[Xi]"}], "-", "1"}], ")"}], " ", 
            SuperscriptBox["q", "2"]}], "+", 
           RowBox[{"15", " ", 
            SuperscriptBox["q0", "4"], " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"6", " ", "\[Xi]"}], "-", "1"}], ")"}]}]}], ")"}], " ", 
         SuperscriptBox["m", "2"]}], "+", 
        RowBox[{
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{
            SuperscriptBox["q", "2"], "-", 
            SuperscriptBox["q0", "2"]}], ")"}], "2"], " ", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"240", " ", 
               SuperscriptBox["\[Xi]", "2"]}], "-", 
              RowBox[{"80", " ", "\[Xi]"}], "+", "7"}], ")"}], " ", 
            SuperscriptBox["q", "4"]}], "-", 
           RowBox[{"20", " ", 
            SuperscriptBox["q0", "2"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"6", " ", "\[Xi]"}]}], ")"}], "2"], " ", 
            SuperscriptBox["q", "2"]}], "+", 
           RowBox[{"15", " ", 
            SuperscriptBox["q0", "4"], " ", 
            SuperscriptBox[
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{"6", " ", "\[Xi]"}]}], ")"}], "2"]}]}], ")"}]}]}], 
       ")"}]}], 
     RowBox[{"15", " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["q", "2"], "-", 
         SuperscriptBox["q0", "2"]}], ")"}], "2"]}]]}],
   SequenceForm[
   "\n f\[CapitalTheta] = ", 
