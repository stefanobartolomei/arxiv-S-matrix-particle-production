Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"From", " ", "the", " ", "Kernel", " ", "factor", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          SqrtBox[
           RowBox[{
             FractionBox[
              RowBox[{"4", 
