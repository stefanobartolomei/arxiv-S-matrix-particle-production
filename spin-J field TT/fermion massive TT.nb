Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"serieResult", " ", "=", " ", 
    RowBox[{"Series", "[", 
     RowBox[{"FinalResult", ",", 
      RowBox[{"{", 
       RowBox[{"\[Epsilon]", ",", "0", ",", "0"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{"consider", " ", "the", " ", 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{
          StyleBox["O", "TI"], "(", 
          SuperscriptBox["\[Epsilon]", "0"], ")"}], TraditionalForm], 
      "errors" -> {}, "input" -> "\\mathcal{O}(\\epsilon^0)", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"], " ", "part", " ", "of", " ", "FinalResult"}], 
   " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"NoPolesPart", " ", "=", " ", 
    RowBox[{"SeriesCoefficient", "[", 
     RowBox[{"serieResult", ",", "0"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Integrate", " ", "to", " ", "extract", " ", "both", " ", "the", " ", 
     "Real", " ", "and", " ", "Imaginary", " ", "part"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"TensorFinal", " ", "=", " ", 
     RowBox[{"Integrate", "[", 
      RowBox[{"NoPolesPart", ",", 
       RowBox[{"{", 
        RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"Assume", " ", 
      TemplateBox[<|"boxes" -> FormBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["q", "TI"], "2"], "<", "0"}], TraditionalForm], 
        "errors" -> {}, "input" -> "q^2 < 0", "state" -> "Boxes"|>,
       "TeXAssistantTemplate"]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"\[CapitalPi]tensor", " ", "=", " ", 
     RowBox[{"Simplify", "[", 
      RowBox[{"TensorFinal", ",", 
       RowBox[{"Assumptions", "->", 
        RowBox[{
         RowBox[{"SP", "[", 
          RowBox[{"q", ",", "q"}], "]"}], "<", "0"}]}]}], "]"}]}], ";", 
    "\[IndentingNewLine]", "\[IndentingNewLine]", 
    RowBox[{"subX", " ", "=", " ", 
     RowBox[{
      RowBox[{"\[CapitalPi]tensor", "/.", 
       RowBox[{
        RowBox[{"Log", "[", 
         RowBox[{"SP", "[", 
          RowBox[{"q", ",", "q"}], "]"}], "]"}], "->", "X"}]}], " ", "//", 
      "Simplify"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"(*", " ", 
     RowBox[{"when", " ", 
      TemplateBox[<|"boxes" -> FormBox[
          RowBox[{"log", "(", 
            SuperscriptBox[
             StyleBox["q", "TI"], "2"], ")"}], TraditionalForm], 
        "errors" -> {}, "input" -> "\\log (q^2)", "state" -> "Boxes"|>,
       "TeXAssistantTemplate"], " ", "has", " ", 
      TemplateBox[<|"boxes" -> FormBox[
          RowBox[{
            SuperscriptBox[
             StyleBox["q", "TI"], "2"], "<", "0"}], TraditionalForm], 
        "errors" -> {}, "input" -> "q^2<0", "state" -> "Boxes"|>,
       "TeXAssistantTemplate"], " ", "the", " ", "imaginary", " ", "part", " ",
       "is", " ", 
      TemplateBox[<|"boxes" -> FormBox[
          RowBox[{"\[Theta]", 
            RowBox[{"(", 
              RowBox[{"-", 
                SuperscriptBox[
                 StyleBox["q", "TI"], "2"]}], ")"}], "\[Pi]"}], 
          TraditionalForm], "errors" -> {}, "input" -> "\\theta(-q^2) \\pi", 
        "state" -> "Boxes"|>,
       "TeXAssistantTemplate"]}], " ", "*)"}], "\[IndentingNewLine]", 
    RowBox[{"Imtens", " ", "=", " ", 
     RowBox[{
      RowBox[{"subX", "/.", " ", 
       RowBox[{"X", "->", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], "*", "\[Pi]"}]}]}], " ", "//", 
      "Simplify"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
     "Look", " ", "at", " ", "the", " ", "expression", " ", "and", " ", 
      "extract", " ", "by", " ", "hand", " ", "the", " ", "imaginary", " ", 
      "part"}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
       "which", " ", "we", " ", "define", " ", "in", " ", "the", " ", "next", 
        " ", "step", "\[IndentingNewLine]", "Imtensnew"}], " ", "=", " ", 
       RowBox[{
        RowBox[{"Collect", "[", 
         RowBox[{"Imtens", ",", "\[Pi]"}], "]"}], " ", "//", 
        "StandardForm"}]}], ";"}]}], "\[IndentingNewLine]", "*)"}], 
   "*)"}]}]}], "Input",
